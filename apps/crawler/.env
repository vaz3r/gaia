# Local development defaults. Production values are in craw-stack/.env on the remote.
# For local dev, use: docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d

PG_PASSWORD=change-me
CRAW_EXTERNAL_IP=127.0.0.1

DB_HOST=127.0.0.1
PG_PORT=55432
POSTGRES_USER=crawler
POSTGRES_DB=craw

CRAW_FETCH_LIMIT=1200
CRAW_RACE_PEERS=12
CRAW_WORKERS=8
CRAW_NODES=1
CRAW_SYBILS=16
CRAW_RATE_LIMIT=8.0
CRAW_WALKER_ALPHA=3
CRAW_WALKER_INTERVAL_MS=250
CRAW_PORT_BASE=6882
CRAW_UTP_ENABLED=true
CRAW_FETCH_TIMEOUT_MS=25000
CRAW_SOURCE_DEADLINE_MS=25000
CRAW_TRACE_SAMPLE_RATE=0.0
RUST_LOG=info

DASH_PORT=3000
CRAW_FIND_NODE_RESPONSE_PERCENT=5
