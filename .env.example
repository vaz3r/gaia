# Copy to .env and fill in real values (never commit .env).
# Production: copy to /home/ubuntu/gaia/.env on the remote host.
# Local dev: keep as .env in the project root.

# ── Required ──
PG_PASSWORD=change-me
CRAW_EXTERNAL_IP=YOUR_VM_PUBLIC_IP
DB_HOST=127.0.0.1               # local dev: 127.0.0.1 (compose DB)
                                 # production: Tailscale IP of workspace-production

# ── Database ──
POSTGRES_USER=crawler
POSTGRES_DB=craw
PG_PORT=5432                     # local dev: 55432 (mapped port); production: 5432

# ── Crawler ──
CRAW_FETCH_LIMIT=1200
CRAW_RACE_PEERS=12
CRAW_WORKERS=8
CRAW_NODES=1
CRAW_SYBILS=16
CRAW_RATE_LIMIT=8.0
CRAW_WALKER_ALPHA=3
CRAW_WALKER_INTERVAL_MS=250
CRAW_PORT_BASE=6881
CRAW_UTP_ENABLED=true
CRAW_FETCH_TIMEOUT_MS=25000
CRAW_SOURCE_DEADLINE_MS=25000
CRAW_TRACE_SAMPLE_RATE=0.01
CRAW_LOG_JSON=true                 # true: JSONL to file; false: human-readable stderr
CRAW_LOG_DIR=/data/logs            # container path for JSONL files
CRAW_LOG_FILE_MAX=52428800         # 50 MB per file
CRAW_LOG_TOTAL_MAX=524288000       # 500 MB total cap
CRAW_LOG_FLUSH_MS=500              # flush interval
CRAW_LOG_BUFFER=8192               # bounded channel capacity
RUST_LOG=info

# ── Dashboard ──
DASH_PORT=3000

# ── Paths (reference) ──
# Compose files:  deploy/compose/
# Deploy scripts: deploy/scripts/
# PostgreSQL:     deploy/postgres/
# Crawler:        apps/crawler/
# Dashboard:      apps/dashboard/
# Classifier:     apps/classifier/
