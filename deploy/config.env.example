# deploy/config.env.example — Deployment infrastructure config template.
# Copy to deploy/config.env and fill in values for the target host.
# deploy/config.env is gitignored (contains the DB password).
#
# Sourced by deploy/scripts/deploy.sh, config-restart.sh, health.sh.
# NOT used by docker-compose (that uses .env).

# SSH
DEPLOY_HOST="your-host-alias"
DEPLOY_USER="ubuntu"
DEPLOY_SSH_KEY="${HOME}/.ssh/your-key"

# Remote paths (derived from DEPLOY_USER)
DEPLOY_REMOTE_GIT="/home/${DEPLOY_USER}/gaia"
DEPLOY_REMOTE_DATA="/home/${DEPLOY_USER}/gaia-data"

# Database (for health.sh remote queries)
DB_HOST="100.87.194.112"
DB_PORT="5432"
DB_USER="crawler"
DB_NAME="craw"
DB_PASSWORD="replace-me"