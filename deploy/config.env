# deploy/config.env — Deployment infrastructure config
# Sourced by deploy.sh, config-restart.sh, health.sh
# This file is NOT used by docker-compose (use .env for that)
#
# To deploy to a new host, edit ONLY this file and .env

# SSH
DEPLOY_HOST="gaia"
DEPLOY_USER="ubuntu"
DEPLOY_SSH_KEY="${HOME}/.ssh/zerone"

# Remote paths (derived from DEPLOY_USER)
DEPLOY_REMOTE_GIT="/home/${DEPLOY_USER}/gaia"
DEPLOY_REMOTE_DATA="/home/${DEPLOY_USER}/gaia-data"

