    use std::net::Ipv4Addr;

    #[test]
    fn bep42_test_vector_1() {
        let ip = IpAddr::V4(Ipv4Addr::new(124, 31, 75, 21));
        let p = bep42_prefix(ip, 1);
        assert_eq!(p[0], 0x5f);
