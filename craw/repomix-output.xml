<file path="deploy.sh">
#!/usr/bin/env bash
set -euo pipefail

# Deploy crawler to zerone (ARM aarch64)
# Usage: ./deploy.sh [zerone-host]
#
# This script:
# 1. Cross-compiles for aarch64 (or builds Docker image on target)
# 2. Deploys the binary to the target host
# 3. Restarts the container
#
# For Docker-based deployment (recommended):
#   docker buildx build --platform linux/arm64 -t dht-crawler .
#   docker compose up -d

HOST="${1:-zerone}"
BUILD_DIR="target/aarch64-unknown-linux-gnu/release"

echo "=== Deploying crawler to $HOST ==="

# Step 1: Cross-compile for aarch64
echo "[1/4] Building for aarch64..."
cd "$(dirname "$0")"
cargo build --release --target aarch64-unknown-linux-gnu

# Step 2: Verify binary architecture
echo "[2/4] Verifying binary..."
file "$BUILD_DIR/craw"

# Step 3: Deploy to remote
echo "[3/4] Copying to $HOST..."
ssh "$HOST" "docker stop craw-crawler 2>/dev/null || true"
scp "$BUILD_DIR/craw" "$HOST:/tmp/craw-new"
ssh "$HOST" "sudo cp /tmp/craw-new /home/ubuntu/craw-stack/craw && sudo chmod 755 /home/ubuntu/craw-stack/craw"

# Step 4: Restart
echo "[4/4] Starting container..."
ssh "$HOST" "docker start craw-crawler"

# Step 5: Verify
sleep 5
echo "=== Verifying deployment ==="
ssh "$HOST" "docker logs --tail 3 craw-crawler 2>&1"

echo ""
echo "=== Deployment complete ==="
echo "Binary: aarch64-unknown-linux-gnu"
echo "Note: For full Docker build, run on target:"
echo "  docker buildx build --platform linux/arm64 -t dht-crawler ."
echo "  docker compose up -d"
</file>

<file path="docker-compose.yml">
name: craw

x-crawler-common: &crawler-common
  build:
    context: .
    dockerfile: Dockerfile
  image: dht-crawler
  init: true
  restart: unless-stopped
  network_mode: host
  depends_on:
    db:
      condition: service_healthy
  volumes:
    - crawler-data:/home/crawler/data

services:
  db:
    image: postgres:16
    container_name: craw-db
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-crawler}
      POSTGRES_PASSWORD: ${PG_PASSWORD:?PG_PASSWORD is required (see .env.example)}
      POSTGRES_DB: ${POSTGRES_DB:-craw}
    command: ["-c", "config_file=/etc/postgresql.conf"]
    volumes:
      - pgdata:/var/lib/postgresql/data
      - ./pg/postgresql.conf:/etc/postgresql.conf:ro
    ports:
      - "0.0.0.0:${PG_PORT:-55432}:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-crawler} -d ${POSTGRES_DB:-craw}"]
      interval: 5s
      timeout: 3s
      retries: 12
      start_period: 5s
    networks:
      - internal

  crawler:
    <<: *crawler-common
    container_name: craw-crawler
    environment:
      CRAW_EXTERNAL_IP: ${CRAW_EXTERNAL_IP:?set your VM public IP in .env}
      CRAW_FETCH_LIMIT: ${CRAW_FETCH_LIMIT:-1200}
      CRAW_RACE_PEERS: ${CRAW_RACE_PEERS:-12}
      CRAW_WORKERS: ${CRAW_WORKERS:-8}
      RUST_LOG: ${RUST_LOG:-info}
      DATABASE_URL: postgres://${POSTGRES_USER:-crawler}:${PG_PASSWORD}@${DB_HOST:-127.0.0.1}:${PG_PORT:-55432}/${POSTGRES_DB:-craw}?sslmode=disable

  dashboard:
    build:
      context: ./dashboard
      dockerfile: Dockerfile
    image: craw-dashboard
    container_name: craw-dashboard
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
    environment:
      DATABASE_URL: postgres://${POSTGRES_USER:-crawler}:${PG_PASSWORD}@db:5432/${POSTGRES_DB:-craw}?sslmode=disable
      PORT: "3000"
    ports:
      - "0.0.0.0:${DASH_PORT:-3000}:3000"
    networks:
      - internal

networks:
  internal:
    driver: bridge

volumes:
  pgdata:
    external: true
    name: craw-pg-data
  crawler-data:
    external: true
    name: dht-crawler-data
