# Copy to .env and fill in real values (never commit .env).
# Required:
PG_PASSWORD=change-me
CRAW_EXTERNAL_IP=YOUR_VM_PUBLIC_IP

# Optional (defaults shown):
POSTGRES_USER=crawler
POSTGRES_DB=craw
DB_HOST=127.0.0.1  # DB client endpoint used by the crawler (loops back to the published port)
PG_PORT=55432      # DB port published on 0.0.0.0 (prefer 5432 locally, or an unroutable port here)
CRAW_FETCH_LIMIT=1200
CRAW_RACE_PEERS=12
CRAW_WORKERS=8
RUST_LOG=info