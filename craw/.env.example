# Copy to .env and fill in real values (never commit .env).
# Required:
PG_PASSWORD=change-me
CRAW_EXTERNAL_IP=YOUR_VM_PUBLIC_IP

# Optional (defaults shown):
POSTGRES_USER=crawler
POSTGRES_DB=craw
DB_HOST=workspace-production.tailfe0c2.ts.net  # Tailscale MagicDNS hostname
PG_PORT=5432
CRAW_FETCH_LIMIT=1200     # Verify concurrency (independent of PG pool)
CRAW_RACE_PEERS=12
CRAW_WORKERS=8
RUST_LOG=info